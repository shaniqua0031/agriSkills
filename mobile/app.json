{
  "expo": {
    "name": "AgriSkills Passport",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {},
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1e1e1e",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.shaton.mobile"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "AgriSkills Passport",
      "shortName": "AgriSkills",
      "description": "Your farming skills, verified: a learner-controlled record of qualifications, skills and evidence.",
      "themeColor": "#1e1e1e",
      "backgroundColor": "#f5f5f5"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "AgriSkills Passport uses your photos so you can attach evidence of your skills.",
          "cameraPermission": "AgriSkills Passport uses the camera so you can photograph evidence of your skills."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AgriSkills Passport adds a location stamp to evidence only when you choose to."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "bdbf2c27-da8c-44c1-a6de-2c27ec878abc"
      }
    }
  }
}
