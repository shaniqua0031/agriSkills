PORT=3000
# Long random string used to sign login tokens. Required when NODE_ENV=production.
JWT_SECRET=
# Long random string used to sign credentials (HMAC-SHA256). Required when NODE_ENV=production.
# Changing it makes every existing signature fail verification.
CREDENTIAL_SIGNING_SECRET=
# Base URL put in share links / QR codes. Leave unset in development (the laptop's Wi-Fi address is used).
# Required in production, e.g. https://your-app.onrender.com
# PUBLIC_BASE_URL=
# Which proxies to trust for the visitor's IP (used by rate limits). Default "loopback" suits a
# Cloudflare tunnel on this machine. On Render set TRUST_PROXY=1.
# TRUST_PROXY=
# Postgres connection string (Neon). Required: the server will not start without it.
DATABASE_URL=
# Evidence photo storage (Cloudinary). Photos are stored privately and shown via short-lived links.
# Leave empty during development to save photos in Server/uploads/ on this machine instead.
# In production (NODE_ENV=production) photo uploads are switched off until these are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Account emails via Gmail (or any SMTP server): your address and an App Password from
# https://myaccount.google.com/apppasswords (needs 2-Step Verification). SMTP_HOST/SMTP_PORT default to Gmail.
SMTP_USER=
SMTP_PASS=
# Or: account emails (verification and password-reset links), sent with Resend (https://resend.com).
# Leave empty during development to print reset links in the server terminal instead.
# In production, sign-up and password reset are switched off until both are set.
RESEND_API_KEY=
# A sender on a domain you verified in Resend, e.g. "AgriSkills Passport <no-reply@yourdomain.com>"
EMAIL_FROM=
# Base app URL used in password reset emails. Set this to the deployed app URL in production.
PASSWORD_RESET_URL=http://localhost:8081/forgot-password
